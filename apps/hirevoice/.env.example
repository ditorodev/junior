# --- GitHub plugin (App-based auth) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_APP_BOT_NAME=
GITHUB_APP_BOT_EMAIL=

# --- GitHub PR webhook ingress ---
# Shared secret on the GitHub webhook itself.
GITHUB_WEBHOOK_SECRET=
# The login of the bot whose comments carry the preview URL.
# Defaults to "vercel[bot]" when unset.
HIREVOICE_PREVIEW_COMMENT_AUTHOR=vercel[bot]
# Junior's Slack user id (e.g. U07XXXX) for the @-mention text.
HIREVOICE_JUNIOR_SLACK_USER_ID=

# --- Subscription store (Turso / libsql) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Internal subscription endpoints ---
# Shared bearer the watch / list / unwatch / verify skills use to call back
# into the bot's own /api/internal/subscriptions routes.
JUNIOR_INTERNAL_TOKEN=
